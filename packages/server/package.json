{
  "name": "@chess350/server",
  "version": "0.1.0",
  "private": true,
  "description": "Game server: Express (static + /healthz) and Socket.IO. Rooms live in memory.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@chess350/core": "^0.1.0",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "socket.io-client": "^4.8.4",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
